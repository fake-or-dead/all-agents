#!/bin/sh
set -eu

if [ -f .env ]; then
    exit 0
fi

cp .env.example .env

app_key="$(docker run --rm php:8.5-cli-bookworm php -r 'echo "base64:".base64_encode(random_bytes(32));')"
db_password="$(docker run --rm php:8.5-cli-bookworm php -r 'echo bin2hex(random_bytes(24));')"

sed -i.bak "s|^APP_KEY=.*$|APP_KEY=${app_key}|" .env
sed -i.bak "s|^DB_PASSWORD=.*$|DB_PASSWORD=${db_password}|" .env
sed -i.bak "s|^POSTGRES_PASSWORD=.*$|POSTGRES_PASSWORD=${db_password}|" .env
rm .env.bak
